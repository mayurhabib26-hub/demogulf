# THE GULF STORE — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─────────────────────────────────────────────────────────
# DEMO MODE
# When VITE_DEMO_MODE=true, all form submissions are
# simulated locally (no backend required). The site will
# clearly label simulated confirmations.
# ─────────────────────────────────────────────────────────
VITE_DEMO_MODE=true

# ─────────────────────────────────────────────────────────
# BACKEND API (required for production)
# Replace with your real server endpoint.
# ─────────────────────────────────────────────────────────
# VITE_API_BASE_URL=https://api.yourdomain.com/v1

# ─────────────────────────────────────────────────────────
# WhatsApp Business API (optional, for real WA message flow)
# ─────────────────────────────────────────────────────────
# VITE_WHATSAPP_BUSINESS_NUMBER=+971500000000

# ─────────────────────────────────────────────────────────
# Email / SMTP (backend use only — never in frontend)
# ─────────────────────────────────────────────────────────
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_smtp_password

# ─────────────────────────────────────────────────────────
# Image Upload Storage (e.g. Cloudinary / S3)
# ─────────────────────────────────────────────────────────
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ─────────────────────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
